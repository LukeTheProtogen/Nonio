# FAVOR NÃO EXPLODIR ESSE ARQUIVO.
# brapi — cotações B3. https://brapi.dev
# PETR4, VALE3, ITUB4 e MGLU3 respondem SEM token; o resto exige.
BRAPI_TOKEN=

# Podemos colocar outras chaves aqui como da OpenAI, Google e etc
# Anthropic usamos para a camada de narrativa e extração das atas do Copom.
# Deixado em branco por ora; sem ele nenhum dado é auditável.
ANTHROPIC_API_KEY=

# Fontes públicas sem chave (coloquei isso aq só para documentar mmesmo:)
# BCB Olinda/Focus  https://olinda.bcb.gov.br/olinda/servico/Expectativas/versao/v1/odata
# BCB SGS           https://api.bcb.gov.br/dados/serie
# CVM dados abertos https://dados.cvm.gov.br/dados/CIA_ABERTA

# Segredo do Vercel Cron. Sem ele, /api/cron/pipeline fica aberto para qualquer
# um disparar. Gere com: openssl rand -hex 32
CRON_SECRET=

# ── Onde cada variável precisa existir ──────────────────────────────────────
# local  : web/.env.local  (BRAPI_TOKEN, CRON_SECRET) e .env na raiz (ANTHROPIC_API_KEY)
# Vercel : Project Settings > Environment Variables (BRAPI_TOKEN, CRON_SECRET)
# Nenhuma delas vai para o browser: só Route Handler e Server Component leem.

# Auth — Supabase (contas) + JWT curto para a FastAPI.
# Contas NÃO ficam em SQLite nem em DuckDB. Sessão no Next via cookies Supabase.
# AUTH_SECRET=  # OBRIGATÓRIO — openssl rand -base64 32 — MESMO valor em web/.env.local e na raiz
#                Sem placeholder. Sem default fraco. API e Next recusam subir/assinar sem ele.
#
# web/.env.local:
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=  # ou NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=     # só servidor; mensagens senha vs Google
# AUTH_SECRET=                   # assina JWT da API
#
# No painel Supabase (cloud) ou CLI local:
# - Auth → Providers → Google (Client ID/Secret do Google Cloud)
# - Redirect URL app: http://localhost:3000/auth/callback  (+ produção)
# - Local Supabase também exige no Google Cloud:
#   http://127.0.0.1:54321/auth/v1/callback
# - Desligar auto-link de identities se quiser bloquear Google em cima de senha
# - Site URL: http://localhost:3000
#
# Local: npx supabase start  (precisa Docker)
# Studio: http://127.0.0.1:54323
# Mailpit: http://127.0.0.1:54324

# JWT_LIFETIME_SECONDS=604800  # legado fastapi-users; API JWT curto é 5m no Next

# Backend (FastAPI + DuckDB + Parquet local)
# DATABASE_URL=duckdb:///C:/path/to/nonio/api/data/nonio.duckdb
# PARQUET_ROOT=C:/path/to/nonio/api/data/parquet
# STOCK_UNIVERSE=              # vazio = top N por market cap na brapi
# STOCK_UNIVERSE_SIZE=600
# BRAPI_HISTORY_RANGE=3mo     # free: 1d/5d/1mo/3mo. Sandbox aceita max. 5y=Pro
# BRAPI_BATCH_SIZE=4           # so vale p/ sandbox; resto = 1/req no free
# BRAPI_CACHE=1
# BRAPI_CACHE_TTL_HOURS=48
# CRON_SOURCES=sgs,brapi,yahoo,b3,copom
# B3_DETAIL_LIMIT=             # vazio = todas ativas; ex: 100 para smoke
# COPOM_QUANTIDADE=500
# SOURCE_CACHE=1
# SOURCE_CACHE_TTL_HOURS=48
# CRON_SKIP_FRESH=1
# CRON_FORCE=0
# NONIO_RESET_DB=0
#
# Yahoo Finance — histórico diário medium/long (não é feed em tempo real).
# Cadência tipica: cron a cada ~2 dias; barras continuam 1d.
# YAHOO_HISTORY_PERIOD=5y
# YAHOO_BATCH_SIZE=20          # simbolos por yf.download
# YAHOO_PAUSE_SEC=5            # pausa entre lotes (~2 req / 5s nos docs OSS)
# YAHOO_REFRESH_HOURS=48       # skip se ainda fresco
# YAHOO_MAX_RETRIES=4
#
# Copom LLM — extração estruturada (Sonnet). Passo 1; citações = passo 2 depois.
# COPOM_LLM_MODELO=claude-sonnet-5
# COPOM_LLM_LIMIT=              # vazio = todos os PDFs locais; ex: 3 para smoke
# COPOM_LLM_NROS=278,279,280    # opcional: lista explícita
# COPOM_LLM_PAUSE_SEC=1

# --- front (web/.env.local) ---
# Autenticação e dados no nonio-api. Vazio = tudo mockado, e o front roda
# sozinho. Definida = login por JWT de verdade.
#   cd backend && uv run uvicorn app.main:app --port 8000
NONIO_API_URL=http://localhost:8000

# --- desenvolvimento local (web/.env.local) ---
# Entra sem Supabase: qualquer e-mail e senha abrem sessão, e a tela avisa em
# caixa amarela que nada está sendo verificado.
#
# A trava são DUAS condições independentes, em src/lib/auth-local.ts e no
# proxy: esta variável E NODE_ENV diferente de production. O `next build` fixa
# NODE_ENV, então esta linha nunca liga nada em produção.
NONIO_AUTH_LOCAL=1

# Quais recursos vêm do nonio-api NESTA máquina. Ausente = o padrão do código
# (hoje "acoes,copom"). Vazio = tudo mockado, e o front roda sem backend.
#
# Existe porque "o backend serve X" depende da máquina, não do código: quem tem
# o parquet ingerido quer /acoes da API; quem não tem quer o mock, senão a tela
# fica vazia e o trabalho de front trava.
NONIO_RECURSOS_BACKEND=acoes,copom
