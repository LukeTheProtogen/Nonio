# FAVOR NÃO EXPLODIR ESSE ARQUIVO.
# brapi — cotações B3. https://brapi.dev
# PETR4, VALE3, ITUB4 e MGLU3 respondem SEM token; o resto exige.
BRAPI_TOKEN=

# Podemos colocar outras chaves aqui como da OpenAI, Google e etc
# Anthropic usamos para a camada de narrativa e extração das atas do Copom.
# Deixado em branco por ora; sem ele nenhum dado é auditável.
ANTHROPIC_API_KEY=

# Fontes públicas sem chave (coloquei isso aq só para documentar mmesmo:)
# BCB Olinda/Focus  https://olinda.bcb.gov.br/olinda/servico/Expectativas/versao/v1/odata
# BCB SGS           https://api.bcb.gov.br/dados/serie
# CVM dados abertos https://dados.cvm.gov.br/dados/CIA_ABERTA

# Segredo do Vercel Cron. Sem ele, /api/cron/pipeline fica aberto para qualquer
# um disparar. Gere com: openssl rand -hex 32
CRON_SECRET=

# ── Onde cada variável precisa existir ──────────────────────────────────────
# local  : web/.env.local  (BRAPI_TOKEN, CRON_SECRET) e .env na raiz (ANTHROPIC_API_KEY)
# Vercel : Project Settings > Environment Variables (BRAPI_TOKEN, CRON_SECRET)
# Nenhuma delas vai para o browser: só Route Handler e Server Component leem.
